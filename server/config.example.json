{
  "_comment": "复制为 config.json 后填写。token 必须换成密码学安全随机值；所有路径换成自己服务器上的真实目录；roots 里的每个目录都要真实存在，键名可自行增减。",

  "token": "<REPLACE_WITH_64_HEX_CHARS>",
  "port": 8787,
  "proxyPort": 8080,
  "proxyHost": "",

  "home": "C:\\srv\\bridge",
  "roots": {
    "data": "C:\\srv\\data",
    "logs": "C:\\srv\\logs",
    "bridge": "C:\\srv\\bridge"
  },

  "denyWrite": [
    "\\.(mdb|ldb|sqlite|bak)$",
    "[\\\\/](\\.git|\\.svn|node_modules)[\\\\/]"
  ],
  "denyRead": [
    "[\\\\/]config\\.json$",
    "\\.(key|pem|pfx|p12)$",
    "[\\\\/]id_rsa",
    "[\\\\/]\\.ssh[\\\\/]"
  ],

  "rateLimitPerMinute": 180,
  "maxBodyBytes": 5242880,

  "execEnabled": false,
  "execHardMaxMs": 600000,
  "execMaxMs": 60000,
  "execMaxCommand": 8000,
  "execMaxOut": 65536,
  "execMaxErr": 16384,
  "execMaxConcurrent": 3,
  "execDeny": [
    "\\bformat\\s+[a-z]:",
    "\\bdiskpart\\b",
    "\\bbcdedit\\b",
    "\\brm\\s+-rf\\s+/",
    "\\bmkfs\\b",
    "\\bdd\\s+if=",
    "\\b(Stop-Computer|Restart-Computer|shutdown\\.exe|reboot)\\b",
    "\\bnet\\s+user\\b[^\\r\\n]*/add",
    "\\bSet-ExecutionPolicy\\b"
  ],
  "execAllow": [],

  "defaultShell": "powershell",
  "oemEncoding": "gbk",
  "shells": {
    "powershell": {
      "exe": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
      "prefix": "[Console]::OutputEncoding=[System.Text.Encoding]::UTF8; ",
      "args": ["-NoProfile", "-NonInteractive", "-ExecutionPolicy", "Bypass", "-Command", "{cmd}"],
      "encoding": "utf8"
    },
    "ps32": {
      "exe": "C:\\Windows\\SysWOW64\\WindowsPowerShell\\v1.0\\powershell.exe",
      "prefix": "[Console]::OutputEncoding=[System.Text.Encoding]::UTF8; ",
      "args": ["-NoProfile", "-NonInteractive", "-ExecutionPolicy", "Bypass", "-Command", "{cmd}"],
      "encoding": "utf8"
    },
    "cmd": {
      "exe": "C:\\Windows\\System32\\cmd.exe",
      "args": ["/d", "/s", "/c", "{cmd}"],
      "encoding": "gbk"
    },
    "sh": {
      "exe": "/bin/sh",
      "args": ["-c", "{cmd}"],
      "encoding": "utf8"
    }
  }
}
